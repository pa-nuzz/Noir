# Core
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1



# --- IMPORTANT: ngrok/Cloudflare Tunnel Setup ---
# Every time you start ngrok, set these three variables to your HTTPS tunnel URL:
# Example: ngrok http 8000
# If your URL is https://YOUR-ID.ngrok-free.app, set:
# TRACKING_BASE_URL=https://YOUR-ID.ngrok-free.app
# CSRF_TRUSTED_ORIGINS=https://YOUR-ID.ngrok-free.app
# ALLOWED_HOSTS=localhost,127.0.0.1,YOUR-ID.ngrok-free.app

PUBLIC_BASE_URL=http://127.0.0.1:8000
TRACKING_BASE_URL=http://127.0.0.1:8000
NGROK_DOMAIN=
CSRF_TRUSTED_ORIGINS=

# Session / security toggles
FORCE_HTTPS=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Cache / Redis
CACHE_BACKEND=locmem
REDIS_CACHE_URL=redis://localhost:6379/0

# SMTP / email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
EMAIL_TIMEOUT=20

# AI provider keys (do NOT commit real keys here)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# App encryption (Fernet key for encrypting secrets at rest)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# PREVIOUS_FERNET_KEYS=key1,key2  # comma-separated old keys for rotation (see inbox/models.py)

# Optional DB (only if you switch from sqlite)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Google Gemini AI (for LLM-based content generation)
GEMINI_API_KEY=

# ML model paths (defaults already work)
ML_MODEL_PATH=models_ml/spam_model.pkl
ML_VECTORIZER_PATH=models_ml/tfidf_vectorizer.pkl

# Frontend/cache busting
STATIC_VERSION=1
SESSION_COOKIE_NAME=dia_session_v2
SESSION_EXPIRE_AT_BROWSER_CLOSE=True
SESSION_COOKIE_AGE=28800
SESSION_SAVE_EVERY_REQUEST=True

# --- Storage backends (per-workspace; only OAuth app credentials live here) ---
# Google Drive: create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${PUBLIC_BASE_URL}/workspaces/storage/google-drive/callback/
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=

# App-wide fallback for self-hosted S3-compatible storage (optional)
# Workspaces can override these from the dashboard.
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

DIA_S3_ENDPOINT_URL	S3 endpoint (e.g. https://s3.amazonaws.com or R2/MinIO URL)
DIA_S3_REGION	Region (default us-east-1)
DIA_S3_BUCKET	Bucket name
DIA_S3_ACCESS_KEY	Access key
DIA_S3_SECRET_KEY	Secret key
DIA_S3_PATH_PREFIX	Optional path prefix
DIA_S3_PUBLIC_BASE_URL	Optional CDN/public URL
DIA_S3_USE_PATH_STYLE	True for MinIO/R2, False for AWS
