class TestCampaignService:

    def test_send_campaign_creates_events(self, campaign, contact_list):
        """Sending a campaign creates CampaignEvent records."""
        contacts = ContactFactory.create_batch(5, workspace=campaign.workspace)
        contact_list.contacts.add(*contacts)

        with mock.patch('apps.campaigns.tasks.send_batch.delay') as mock_send:
