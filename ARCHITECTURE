    sent_at = DateTimeField(null=True)
    completed_at = DateTimeField(null=True)
    total_recipients = IntegerField(default=0)
    sent_count = IntegerField(default=0)
    open_count = IntegerField(default=0)
    click_count = IntegerField(default=0)
    bounce_count = IntegerField(default=0)
    complaint_count = IntegerField(default=0)
    unsubscribe_count = IntegerField(default=0)
