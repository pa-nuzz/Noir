    class Meta:
        ordering = ['-created_at']
        indexes = [
            Index(fields=['workspace', 'status']),
            Index(fields=['workspace', 'created_at']),
            Index(fields=['scheduled_at']),
        ]

    @property
    def open_rate(self):
        return round((self.open_count / self.sent_count * 100), 2) if self.sent_count else 0

    @property
    def click_rate(self):
        return round((self.click_count / self.sent_count * 100), 2) if self.sent_count else 0


