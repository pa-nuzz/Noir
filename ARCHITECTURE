### 7.6 AI Memory/Context System

```python
# apps/ai_agents/memory.py

class AgentMemory:
    """Shared context memory for AI agents."""

    def __init__(self, workspace):
        self.workspace = workspace
        self.redis = redis.Redis.from_url(settings.REDIS_URL)

    def get_context(self, agent_type, conversation_id):
        """Get conversation memory."""
        # Check Redis first (hot cache)
        cache_key = f'memory:{agent_type}:{conversation_id}'
        cached = self.redis.get(cache_key)
        if cached:
            return json.loads(cached)

        # Fall back to DB
        try:
            memory = AIMemory.objects.get(
                workspace=self.workspace,
                agent_type=agent_type,
                conversation_id=conversation_id
            )
            # Cache in Redis for 1 hour
            self.redis.setex(cache_key, 3600, json.dumps(memory.context))
            return memory.context
        except AIMemory.DoesNotExist:
            return {'summary': '', 'history': [], 'metadata': {}}

    def update_context(self, agent_type, conversation_id, new_content):
        """Update conversation memory with new exchange."""
        memory, created = AIMemory.objects.get_or_create(
            workspace=self.workspace,
            agent_type=agent_type,
            conversation_id=conversation_id,
            defaults={'context': {'history': [], 'summary': '', 'metadata': {}}}
        )

        # Append to history (keep last 10 exchanges)
        history = memory.context.get('history', [])
        history.append(new_content)
        if len(history) > 10:
            history = history[-10:]

        # Regenerate summary if history changed significantly
        summary = memory.context.get('summary', '')
        if len(history) % 3 == 0:  # Every 3 exchanges
            summary = self._generate_summary(history)

        memory.context = {
            'history': history,
            'summary': summary,
            'metadata': memory.context.get('metadata', {}),
        }
        memory.save(update_fields=['context', 'summary', 'updated_at'])

        # Invalidate cache
        cache_key = f'memory:{agent_type}:{conversation_id}'
        self.redis.delete(cache_key)

    def _generate_summary(self, history):
        """Generate a summary of conversation history using AI."""
        provider = AIProviderRouter(self.workspace).get_provider()
        text = '\n'.join([f"{h.get('intent', '')}: {h.get('summary', '')[:200]}" for h in history])
        result = provider.generate(
            prompt=f"Summarize this conversation thread:\n\n{text}",
            system_prompt="Provide a 2-3 sentence summary.",
            max_tokens=150,
        )
        return result['content']
