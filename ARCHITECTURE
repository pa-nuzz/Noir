# apps/campaigns/tasks.py

@shared_task(queue='high', bind=True, max_retries=3)
def send_campaign(self, campaign_id):
    """Send a campaign to all recipients in batches."""
    campaign = Campaign.objects.get(id=campaign_id)
    campaign.status = 'sending'
    campaign.save(update_fields=['status'])

    try:
        sender = campaign.sender
        contacts = Contact.objects.filter(
            contactlistmember__contact_list__in=campaign.contact_lists.all(),
            is_subscribed=True
        ).distinct()

        total = contacts.count()
        campaign.total_recipients = total
        campaign.save(update_fields=['total_recipients'])

        batch_size = 100
        for offset in range(0, total, batch_size):
            batch = contacts[offset:offset + batch_size]
            send_batch.delay(campaign_id, [c.id for c in batch])

    except Exception as exc:
        campaign.status = 'failed'
        campaign.save(update_fields=['status'])
        raise self.retry(exc=exc, countdown=60 * (self.request.retries + 1))


@shared_task(queue='high', max_retries=3)
def send_batch(self, campaign_id, contact_ids):
    """Send a batch of emails."""
    campaign = Campaign.objects.get(id=campaign_id)
    sender = campaign.sender

    for contact_id in contact_ids:
        contact = Contact.objects.get(id=contact_id)
        try:
            # Inject tracking pixel
            html = campaign.body_html
            event = CampaignEvent.objects.create(
                campaign=campaign, contact=contact,
                email=contact.email, event_type='sent'
            )
            tracking_pixel = (
                f'<img src="https://api.ida.ai/t/open/{event.id}" '
                f'width="1" height="1" alt="" />'
            )
            html = html.replace('</body>', f'{tracking_pixel}</body>')

            # Wrap links
            for link in campaign.links.all():
                tracked_url = f'https://api.ida.ai/t/click/{event.id}/{link.id}'
                html = html.replace(link.url, tracked_url)

            # Send via sender's SMTP
            send_single_email(sender, contact.email, campaign.subject, html)

            campaign.sent_count += 1
            campaign.save(update_fields=['sent_count'])

        except Exception as exc:
            CampaignEvent.objects.create(
                campaign=campaign, contact=contact,
                email=contact.email, event_type='failed',
                metadata={'error': str(exc)}
            )
            self.retry(exc=exc, countdown=60)


@shared_task(queue='low')
def track_open_event(event_id):
    """Process open tracking events."""
    event = CampaignEvent.objects.get(id=event_id)
    event.event_type = 'opened'
    event.save(update_fields=['event_type'])
    event.campaign.open_count += 1
    event.campaign.save(update_fields=['open_count'])


@shared_task(queue='low')
def track_click_event(event_id, link_id):
    """Process click tracking events."""
    event = CampaignEvent.objects.get(id=event_id)
    campaign_event = CampaignEvent.objects.create(
        campaign=event.campaign, contact=event.contact,
        email=event.email, event_type='clicked',
        metadata={'link_id': link_id}
    )
    event.campaign.click_count += 1
    event.campaign.save(update_fields=['click_count'])
    Link.objects.filter(id=link_id).update(
