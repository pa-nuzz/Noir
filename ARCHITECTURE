### 7.1 AI Provider Abstraction Layer

```python
# services/ai_service.py

class AIProviderRouter:
    """Route AI requests to configured provider."""

    def __init__(self, workspace=None):
        self.workspace = workspace

    def get_provider(self, preferred=None):
        """Get the best available AI provider for workspace."""
        if preferred:
            return self._init_provider(preferred)
        # Default: OpenAI, fallback to workspace config
        return self._init_provider('openai')

    def _init_provider(self, provider_name):
        providers = {
            'openai': OpenAIProvider,
            'claude': ClaudeProvider,
            'gemini': GeminiProvider,
        }
        cls = providers.get(provider_name)
        if not cls:
            raise ValueError(f'Unknown provider: {provider_name}')
        config = self._get_provider_config(provider_name)
        return cls(**config)

    def _get_provider_config(self, provider_name):
        if self.workspace:
            try:
                provider = AIProvider.objects.get(
                    workspace=self.workspace,
                    provider=provider_name,
                    is_active=True
                )
                return {
                    'api_key': provider.get_decrypted_key(),
                    'model': provider.model,
                }
            except AIProvider.DoesNotExist:
                pass
        # Fallback to global API key from settings
        return {
            'api_key': settings.AI_PROVIDERS[provider_name]['api_key'],
            'model': settings.AI_PROVIDERS[provider_name]['default_model'],
        }


class BaseAIProvider(ABC):
    """Abstract base for AI providers."""

    @abstractmethod
    def generate(self, prompt, system_prompt=None, **kwargs):
        ...

    @abstractmethod
    def generate_stream(self, prompt, system_prompt=None, **kwargs):
        ...

    def count_tokens(self, text):
        ...


class OpenAIProvider(BaseAIProvider):
    def __init__(self, api_key, model='gpt-4'):
        self.client = OpenAI(api_key=api_key)
        self.model = model

    def generate(self, prompt, system_prompt=None, **kwargs):
        messages = []
        if system_prompt:
            messages.append({'role': 'system', 'content': system_prompt})
        messages.append({'role': 'user', 'content': prompt})

        response = self.client.chat.completions.create(
            model=self.model,
            messages=messages,
            temperature=kwargs.get('temperature', 0.7),
            max_tokens=kwargs.get('max_tokens', 1024),
        )
        return {
            'content': response.choices[0].message.content,
            'model': self.model,
            'tokens': {
                'prompt': response.usage.prompt_tokens,
                'completion': response.usage.completion_tokens,
                'total': response.usage.total_tokens,
            },
            'cost': self._calculate_cost(response.usage),
        }
