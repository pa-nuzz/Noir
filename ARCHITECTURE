# apps/ai_agents/agents/base.py

class BaseAgent(ABC):
    """Base class for all AI agents."""

    def __init__(self, workspace, agent_config=None):
        self.workspace = workspace
        self.config = agent_config or {}
        self.router = AIProviderRouter(workspace)
        self.memory = AgentMemory(workspace)

    @abstractmethod
    def execute(self, input_data):
        """Execute agent task. Returns AgentRun result."""
        ...

    def get_prompt_template(self, category):
        """Get the appropriate prompt template."""
        template = PromptTemplate.objects.filter(
            Q(workspace=self.workspace) | Q(is_global=True),
            category=category,
            is_active=True,
        ).order_by('-is_global', '-version').first()
        return template

    def record_run(self, agent, input_data, output_data, status, duration_ms, tokens_used, cost):
        """Record agent execution."""
        AgentRun.objects.create(
            agent=agent,
            status=status,
            input_data=input_data,
            output_data=output_data,
            duration_ms=duration_ms,
            tokens_used=tokens_used,
            cost=cost,
        )


# apps/ai_agents/agents/email_reply.py

class EmailReplyAgent(BaseAgent):
    """Generate email replies with context awareness."""

    def execute(self, input_data):
        email_id = input_data.get('email_id')
        email = EmailMessage.objects.get(id=email_id)

        # Step 1: Summarize
        summary = self._summarize_email(email)

        # Step 2: Detect intent & urgency
        intent = self._detect_intent(email, summary)
        urgency = self._detect_urgency(email, summary)

        # Step 3: Get conversation context
        context = self.memory.get_context(
            agent_type='email_reply',
            conversation_id=email.thread_id
        )

        # Step 4: Generate reply
        provider = self.router.get_provider()
        template = self.get_prompt_template('email_reply')

        system_prompt = template.system_prompt.format(
            intent=intent,
            urgency=urgency,
            sender_name=email.from_name or email.from_email,
            subject=email.subject,
        )
        user_prompt = template.user_prompt_template.format(
            summary=summary,
            email_body=email.body_text[:2000],
            conversation_context=context.get('summary', ''),
        )

        result = provider.generate(
            prompt=user_prompt,
            system_prompt=system_prompt,
            temperature=0.7,
        )

        # Step 5: Save context to memory
        self.memory.update_context(
            agent_type='email_reply',
            conversation_id=email.thread_id,
            new_content={
                'email_id': email_id,
                'reply': result['content'],
                'intent': intent,
                'urgency': urgency,
            }
        )

        return {
            'reply_body': result['content'],
            'subject': f"Re: {email.subject}",
            'intent': intent,
            'urgency': urgency,
            'confidence_score': 0.85,
            'ai_model': result['model'],
            'tokens_used': result['tokens']['total'],
            'cost': result['cost'],
        }

    def _summarize_email(self, email):
        provider = self.router.get_provider()
        prompt = f"Summarize this email in 2-3 sentences:\n\n{email.body_text[:2000]}"
        result = provider.generate(prompt, system_prompt='You are an email assistant.', max_tokens=200)
        return result['content']

    def _detect_intent(self, email, summary):
        provider = self.router.get_provider()
        prompt = f"Classify the intent of this email: question, complaint, support, sales, introduction, follow_up,或者其他"
        result = provider.generate(prompt, system_prompt='Classify into exactly one category.', max_tokens=50)
        return result['content'].strip().lower()

    def _detect_urgency(self, email, summary):
        # Keyword-based pre-filter + AI confirmation
        urgent_keywords = ['urgent', 'asap', 'critical', 'deadline', 'emergency']
        if any(kw in email.body_text.lower() for kw in urgent_keywords):
            return 'high'
        return 'medium'
